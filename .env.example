# Copia este archivo a ".env" y rellena los valores.
# ".env" está en .gitignore: NUNCA se sube a Git. Este archivo (.env.example)
# sí se sube, y por eso no debe contener ningún secreto real.

# Clave para firmar las cookies de sesión. OBLIGATORIA (la app no arranca sin ella).
# Genera una distinta para cada entorno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria

# Base de datos (valores de desarrollo; con docker compose el servicio web ya usa DB_HOST=db)
DB_HOST=localhost
DB_NAME=calasanz_db
DB_USER=postgres
DB_PASS=postgres

# 1 en producción con HTTPS (cookie Secure + cabecera HSTS); 0 en desarrollo local.
COOKIE_SECURE=0

# 1 SOLO en desarrollo: activa el depurador de Flask, que permite ejecutar
# código desde el navegador. NUNCA en producción.
FLASK_DEBUG=0
